<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>CS8600;CS8602;CS8603</WarningsAsErrors>
        <PackOnBuild>true</PackOnBuild>
        <PackageId>StitchDB</PackageId>
        <PackageProjectUrl>https://github.com/stitchdb/stitchdb-csharp/tree/main/packages/StitchDB</PackageProjectUrl>
        <RootNamespace>StitchDB</RootNamespace>
        <AssemblyName>StitchDB</AssemblyName>
        <Description>StitchDB client for .NET that composes Auth, Database, Storage, Realtime and Edge Functions behind one client.</Description>
        <NeutralLanguage>en</NeutralLanguage>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <PackageTags>stitchdb;postgres;baas;auth;storage;realtime;edge-functions;blazor;maui</PackageTags>
        <!-- x-release-please-start-version -->
        <ReleaseVersion>1.0.0</ReleaseVersion>
        <PackageVersion>1.0.0</PackageVersion>
        <!-- x-release-please-end -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
   
    <PropertyGroup Condition=" '$(Version)' == '' ">
        <VersionPrefix Condition=" '$(VersionPrefix)' == '' ">1.0.0</VersionPrefix> <!-- x-release-please-version -->
        <Version Condition=" '$(Version)' == '' ">$(VersionPrefix)</Version>
    </PropertyGroup>
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
    
    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Core\Core.csproj" />
        <ProjectReference Include="..\..\Functions\Functions\Functions.csproj" />
        <ProjectReference Include="..\..\Gotrue\Gotrue\Gotrue.csproj" />
        <ProjectReference Include="..\..\Postgrest\Postgrest\Postgrest.csproj" />
        <ProjectReference Include="..\..\Realtime\Realtime\Realtime.csproj" />
        <ProjectReference Include="..\..\Storage\Storage\Storage.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
</Project>
